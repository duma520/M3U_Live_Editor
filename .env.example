# M3U 直播源编辑管理系统 - 配置文件示例
# 复制本文件为 .env 并按需填写，程序启动时会自动加载。
# 注意：.env 不要上传到公开仓库。

# 可选：EPG / 接口 API Key
M3ULE_EPG_API_KEY=

# 可选：数据库密码（本地 SQLite 无需密码）
M3ULE_DB_PASSWORD=

# 可选：网络代理
# M3ULE_PROXY=http://127.0.0.1:7890

# 可选：自定义 User-Agent
# M3ULE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# 可选：自定义数据库文件位置
# M3ULE_DB_PATH=
